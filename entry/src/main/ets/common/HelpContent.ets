// 帮助条目（功能名 + 一句话短描述 + 详细用法段落 + 可选跳转目标）
export interface HelpItem {
  // 功能名（条目主行 / 详情页标题）
  title: string;
  // 一句话短描述（条目副行）
  desc: string;
  // 详细用法段落（详情页正文，面向大众语言；一段一个意思）
  detail: string[];
  // 可选跳转目标（2026-09-06 帮助详情跳转按钮）：配了 = 详情页正文卡下方显示
  // 「前往相关设置」键直达该设置页（页级直达跳页不跳卡，pushPathByName 无参）；
  // 不配 = 无跳转键。值必须引用 RouteNames.ets 的 ROUTE_* 常量（禁裸字符串），
  // 且常量必须在 PageMapBuilder 有分支——scripts/help-search-check.mjs 机械校验
  //（pushPathByName 无回调，路由名无分支时点击静默无反应）。四类不配：纯概念
  // 阐释 / 入口在会话页或 Tab 内容页且功能无独立页（不经 PageMap 无法 push）/
  // 目标页需 id 参数 /
  // ★ 目标页能再进帮助详情的页面（防循环——搜索页 2026-09-06 决明真机拍板摘除：
  // 搜索结果含程序化生成的帮助条目、点选直达详情，「详情→搜索→详情」闭环；复配
  // 即复环。规约同入头注释「帮助条目写作规范」节）。
  route?: string;
}

// 帮助分组（卡外左上标题 + 卡片条目清单）
export interface HelpGroup {
  title: string;
  items: HelpItem[];
}

