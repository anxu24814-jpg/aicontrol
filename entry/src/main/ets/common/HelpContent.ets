// 条目 id 还原（帮助中心页 push 参数 → 条目内容；id = 分组标题::条目标题）。
// 找不到时返回 undefined（详情页给兜底提示——结构性防御，正常链路不会命中）
export function findHelpTopic(id: string): HelpItem | undefined {
  const sep: number = id.indexOf('::');
  if (sep <= 0 || sep >= id.length - 2) {
    return undefined;
  }
  const groupTitle: string = id.slice(0, sep);
  const itemTitle: string = id.slice(sep + 2);
  const group: HelpGroup | undefined = HELP_GROUPS.find((g: HelpGroup) => g.title === groupTitle);
  if (group === undefined) {
    return undefined;
  }
  return group.items.find((item: HelpItem) => item.title === itemTitle);
}
