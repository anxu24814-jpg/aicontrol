{
  "apiType": "stageMode",
  "buildOption": {
    // 代码工作台 native 模块（2026-10-05 端侧代码工作台笔——工程首例 native 层，任务书
    // §3.1：JSVM 沙箱桥 libcodeexec.so；abiFilters 只出 arm64-v8a〔真机全为 arm64，
    // x86_64 仅模拟器用——执行笔若需模拟器再加并在变更记录写明理由〕；本节是本笔唯一
    // 允许的构建配置改动，其余字段逐字不动）
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "abiFilters": ["arm64-v8a"]
    },
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
    // ★ 2026-10-10 阶段6第二段退役笔：原「双渲染 so 去重」nativeLib.filter 整块随
    // markdown_hybrid 卸载删除——五对同名 so 冲突对（markdown_hybrid@1.3.6 vs
    // formula_hybrid@1.3.2）因前者退役而消失，规则失去对象。formula_hybrid（新引擎数学
    // 依赖）全量 so/runtime/字体/资源保留，禁反向加排除（残存库失载红线——history:
    // 2026-09-02 一轮「排 runtime 整目录误杀 markdown 侧独有依赖致正文空白」教程）。
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}